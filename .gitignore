# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.svelte-kit/
.output/
.wrangler/

# Env / secrets — EODHD API key, R2 credentials, etc.
.env
.env.*
!.env.example

# Data pipeline artifacts — panel snapshots are built, not committed
data/
*.parquet
*.feather

# Python pipeline
__pycache__/
*.pyc
.venv/
venv/

# Test / coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
.worktrees/

# Vite
vite.config.ts.timestamp-*

# Dev files
.dev/

# Claude working files (run manifests, locks, agent worktrees)
.claude/

# Terraform (the .terraform.lock.hcl provider lockfile IS committed)
terraform/**/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.*
terraform/**/*.tfplan
terraform/**/crash.log
terraform/**/override.tf
terraform/**/override.tf.json
