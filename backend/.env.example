# Free-tier key for the T-1001-1 schema sanity check only (not the paid
# backfill in T-1001-9). Get one at https://eodhd.com/register — no card
# required for the free tier.
EODHD_API_KEY=

# T-1001-8: comma-separated frontend origins allowed to call this API.
# Must be the deployed frontend's real URL in production — never "*".
# Local dev default:
CORS_ALLOWED_ORIGINS=http://localhost:5173

# T-1001-8: per-client-address request budget applied to every route
# (AC4 abuse protection), "<count>/<period>" per the `limits` package's
# syntax (e.g. "60/minute", "1000/hour"). Optional -- defaults to
# 60/minute if unset (see backend/main.py's `_rate_limit_default`).
RATE_LIMIT_DEFAULT=60/minute
