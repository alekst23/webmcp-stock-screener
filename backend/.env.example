# Free-tier key for the T-1001-1 schema sanity check only (not the paid
# backfill in T-1001-9). Get one at https://eodhd.com/register — no card
# required for the free tier.
EODHD_API_KEY=

# T-1001-8: comma-separated frontend origins allowed to call this API.
# Must be the deployed frontend's real URL in production — never "*".
# Local dev default:
CORS_ALLOWED_ORIGINS=http://localhost:5173

# T-1001-8: per-client-address request budget applied to every route
# (AC4 abuse protection), "<count>/<period>" per the `limits` package's
# syntax (e.g. "60/minute", "1000/hour"). Optional -- defaults to
# 60/minute if unset (see backend/main.py's `_rate_limit_default`).
RATE_LIMIT_DEFAULT=60/minute

# T-1001-9: Cloudflare R2 (or any S3-API) bucket holding the real backfilled
# panel and the parsed universe metadata. Object storage rather than a Render
# disk -- attaching a disk on Render needs a paid instance tier that costs far
# more than ~60-90MB of Parquet (docs/reference/data-provider.md).
#
# All four must be set together: with any of them missing the backend falls
# back to the local mock panel instead of failing (see
# backend/application/load_panel.py), and the ingestion scripts refuse to run
# and name what is unset. NEVER commit real values -- on Render these are
# dashboard secrets (`sync: false` in render.yaml).
R2_BUCKET_NAME=
# Account-scoped S3 endpoint, e.g.
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# R2 API token credentials, from Cloudflare's "Manage R2 API Tokens" ->
# "Create API token" with Object Read & Write on this bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
