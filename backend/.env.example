# Free-tier key for the T-0001-1 schema sanity check only (not the paid
# backfill in T-0001-9). Get one at https://eodhd.com/register — no card
# required for the free tier.
EODHD_API_KEY=

# T-0001-8: comma-separated frontend origins allowed to call this API.
# Must be the deployed frontend's real URL in production — never "*".
# Local dev default:
CORS_ALLOWED_ORIGINS=http://localhost:5173

# T-0001-8: per-client-address request budget applied to every route
# (AC4 abuse protection), "<count>/<period>" per the `limits` package's
# syntax (e.g. "60/minute", "1000/hour"). Optional -- defaults to
# 60/minute if unset (see backend/main.py's `_rate_limit_default`).
RATE_LIMIT_DEFAULT=60/minute

# T-0001-9 / T-0016-3: object storage holding the real backfilled panel and
# the parsed universe metadata -- AWS S3 in production, or any S3-compatible
# endpoint (Cloudflare R2 included). Object storage rather than a local disk
# -- attaching a persistent disk to a Render instance needs a paid tier that
# costs far more than ~60-90MB of Parquet (docs/reference/data-provider.md).
#
# OBJECT_STORE_BUCKET is REQUIRED to reach real data; every other variable
# below is OPTIONAL. Leaving the bucket unset is what "not configured" means
# -- the backend falls back to the local mock panel and the ingestion
# scripts refuse to run, naming it (see backend/application/load_panel.py,
# backend/scripts/_cli_env.py). Once the bucket IS set, the store must be
# reachable or startup fails loudly naming the bucket and the cause -- it
# never silently serves the mock panel as if it were real.
#
# NEVER commit real values -- these were Render dashboard secrets
# (`sync: false` in render.yaml); on AWS App Runner / ECS Fargate they are
# not set at all, since the task's own IAM role supplies credentials.

# REQUIRED. The bucket name, e.g. "webmcp-panels-prod".
OBJECT_STORE_BUCKET=

# OPTIONAL. Set only for a non-AWS S3-compatible endpoint, e.g. R2's
# account-scoped URL: https://<account-id>.r2.cloudflarestorage.com. Leave
# unset against real S3 so boto3 resolves the regional endpoint itself.
OBJECT_STORE_ENDPOINT_URL=

# OPTIONAL. The bucket's AWS region, e.g. "us-east-1". R2 has no regions but
# still needs a scope name for SigV4 signing -- use "auto", the value
# Cloudflare documents. Unset falls back to boto3's own ambient region
# resolution (AWS_REGION / the instance's default).
OBJECT_STORE_REGION=

# OPTIONAL, paired. Static credentials: an R2 API token's key pair (from
# Cloudflare's "Manage R2 API Tokens" -> "Create API token" with Object Read
# & Write on this bucket), or an IAM user's access key for S3. Leave both
# unset to authenticate through the ambient AWS credential chain instead --
# the instance/task role on App Runner or ECS Fargate, with no long-lived
# key to leak.
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=

# T-0016-12: opt-in production guard. When OBJECT_STORE_BUCKET above is
# unset, the default (this variable unset, or set to anything other than
# "true"/"1") is to fall back to the local mock panel -- correct for a local
# checkout, and how the whole test suite runs. Set REQUIRE_REAL_PANEL=true
# to change that: with it truthy and no bucket configured, startup refuses
# to start rather than silently serve synthetic data, naming
# OBJECT_STORE_BUCKET as the unset variable. It has no effect once a bucket
# IS configured -- an unreachable configured store already fails loudly on
# its own (see above). Render's production web service sets this to "true"
# in render.yaml; nothing else needs to.
REQUIRE_REAL_PANEL=
